# IngredientSight-AI backend environment variables.
# Copy to .env and fill in only what you need. EVERYTHING IS OPTIONAL:
# the app runs with no keys at all (template report only, no web context).

# ---- Optional LLM summary (rewrites the deterministic report; never adds facts).
# LLM_PROVIDER must name a supported provider. Currently supported: gemini
LLM_PROVIDER=
# Model name is read from the environment only. Example value for the gemini
# provider is listed in the provider documentation; this file intentionally
# does not pin one.
LLM_MODEL=
LLM_API_KEY=

# ---- Optional web context panel (Tavily). Never part of the assessment.
TAVILY_API_KEY=

# ---- Server / infrastructure
# Comma separated extra origins in addition to http://localhost:5173 and *.vercel.app
ALLOWED_ORIGINS=
PORT=8000
# Requests per minute per IP
RATE_LIMIT_ANALYZE=30
RATE_LIMIT_WEB=10
